# Application Settings
APP_NAME="Phone Number Intelligence Aggregator"
APP_VERSION="1.0.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# Optional External API Keys (Leave empty for built-in zero-cost free scrapers)
TELLOWS_API_KEY=""
TELLOWS_PARTNER_NAME=""
GOOGLE_PLACES_API_KEY=""

# Request Timeouts & Concurrency
SCRAPER_TIMEOUT_SECONDS=6.0
SCRAPER_CONCURRENCY_LIMIT=5
DEFAULT_COUNTRY="PT"
